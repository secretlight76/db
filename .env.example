# Environment Configuration Template
# Copy this to .env.local for development or set in Cloudflare Pages dashboard

# Application Environment
ENVIRONMENT=development

# Cloudflare Pages Configuration
CLOUDFLARE_ACCOUNT_ID=your_account_id_here
CLOUDFLARE_PROJECT_NAME=audio-level-converter
CLOUDFLARE_PAGES_URL=http://localhost:8080

# Analytics and Monitoring
ENABLE_ANALYTICS=false
SENTRY_DSN=

# Application Settings
APP_NAME=Le Convertisseur de Niveaux Audio
APP_VERSION=1.0.0
ENABLE_DEBUG=false
